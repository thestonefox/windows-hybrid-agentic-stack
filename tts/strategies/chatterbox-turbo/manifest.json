  "models": [{"source": "https://huggingface.co/ResembleAI/chatterbox-turbo", "revision": "749d1c1a46eb10492095d68fbcf55691ccf137cd", "license": "MIT"}],
  "voiceReference": {"transcriptRequired": false, "files": ["{name}_prompt.pt"]}

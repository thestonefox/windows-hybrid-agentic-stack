{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "piper-tts",
  "version": "1.0.0",
  "name": "Piper TTS",
  "description": "Lightweight CPU speech using the LJ Speech English voice; no reference-recording cloning.",
  "platforms": [
    "windows-x64"
  ],
  "devices": [
    "cpu"
  ],
  "prerequisites": {
    "visualCpp": true,
    "python": "3.11"
  },
  "capabilities": {
    "voiceCloning": false,
    "builtinVoice": true
  },
  "entrypoints": {
    "backend": "backend.py",
    "install": "install.ps1",
    "uninstall": "uninstall.ps1"
  },
  "files": [
    "install.ps1",
    "uninstall.ps1",
    "backend.py",
    "requirements.txt",
    "prepare_model.py",
    "NOTICE.md"
  ],

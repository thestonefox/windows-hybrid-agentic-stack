{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WHAS TTS strategy API v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "apiVersion",
    "id",
    "version",
    "name",
    "description",
    "platforms",
    "devices",
    "prerequisites",
    "capabilities",
    "entrypoints",
    "files",
    "license",
    "models"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "apiVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,47}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "windows-x64"
        ]
      }
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "cpu",
          "cuda"
        ]
      }
    },
    "prerequisites": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "visualCpp"
      ],
      "properties": {
        "python": {
          "type": "string",
          "pattern": "^3\\.\\d+$"
        },
        "visualCpp": {
          "type": "boolean"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "builtinVoice",
        "voiceCloning"
      ],
      "properties": {
        "builtinVoice": {
          "type": "boolean"
        },
        "voiceCloning": {
          "type": "boolean"
        }
      }
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "install",
        "uninstall",
        "backend"
      ],
      "properties": {
        "install": {
          "type": "string"
        },
        "uninstall": {
          "type": "string"
        },
        "backend": {
          "type": "string"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "license"
        ],
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^https://"
          },
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "anyOf": [
          {
            "required": [
              "revision"
            ]
          },
          {
            "required": [
              "sha256"
            ]
          }
        ]
      }
    },
    "voiceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transcriptRequired"
      ],
      "properties": {
        "transcriptRequired": {
          "type": "boolean"
        }
      }
    }
  }
}
